# Copy to .env and fill in. NEVER commit .env.
# .env.example can be committed.

# Postgres (local dev defaults — change for prod)
POSTGRES_USER=ciphra
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ciphra

# Flask / JWT. Must be ≥32 chars.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Comma-separated allowed origins. Wildcard ("*") is refused by Flask-CORS
# when supports_credentials=True, so list origins explicitly.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
