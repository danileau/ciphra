# Copy to .env and fill in. NEVER commit .env.
# .env.example can be committed.

# Postgres (local dev defaults — change for prod)
POSTGRES_USER=ciphra
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ciphra

# Flask / JWT. Must be ≥32 chars.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Comma-separated allowed origins. Wildcard ("*") is refused by Flask-CORS
# when supports_credentials=True, so list origins explicitly.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: rate-limit storage backend. Unset in dev → flask-limiter falls
# back to in-memory (per-worker, lost on restart — fine for local). In
# production this MUST point at a shared store so counters survive app
# restarts and are shared across gunicorn workers.
# REDIS_URL=redis://redis:6379/0

# ─── AGPL-3.0 §13 — the source offer of THIS deployment ─────────────────────
# ciphra is licensed AGPL-3.0-only. §13 obliges whoever operates it over a
# network to offer their users the Corresponding Source of the version they
# are actually running.
#
# Leave this UNSET only if you run ciphra unmodified — then the app links to
# upstream, which is the truth. If you changed ANYTHING (a patch, a theme, a
# different blueprint), point it at your own repository. A modified instance
# that still links upstream is not compliant: it shows users code that is not
# what you are serving.
#
# Read at runtime, so setting it on a pulled ghcr.io image is enough — no
# rebuild needed.
# PUBLIC_SOURCE_URL=https://git.example.org/you/ciphra
