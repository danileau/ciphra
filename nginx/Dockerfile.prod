# Prod nginx image — bakes the ciphra config into the stock alpine image.
# Built + signed by CI as ghcr.io/danileau/ciphra-nginx:<sha> since
# 2026-06-12 (moved in-repo from golive/nginx so ALL prod images are
# pipeline-created; config changes now flow through PR + CI, which
# structurally kills the rsync-drift incident class — see
# feedback_golive_rsync_drift). TLS material is NOT in the image:
# certs stay bind-mounted on the VPS; this config only references
# their runtime paths.

FROM nginx:1.27-alpine

# Patch the Alpine base packages (openssl/libcrypto3, musl, nghttp2, zlib,
# libexpat, libpng, libxml2, …). The pinned nginx:1.27-alpine tag lags the
# Alpine security repo, so Trivy flags fixed-upstream CVEs; `apk upgrade` pulls
# the current patched builds at image-build time. Most are unreachable in this
# reverse-proxy role (no PNG/XML/expat parsing; zlib untgz unused; the 32-bit
# X.509 overflow needs a 32-bit host) — but openssl (TLS) / musl / nghttp2 are
# in the request path, so we patch the whole base regardless.
#
# CACHEBUST (commit SHA, set by release-images.yml) forces this layer to re-run
# every release so `apk upgrade` hits the current Alpine security repo. Without
# it the gha build cache replays a stale layer and :latest drifts behind
# fixed-upstream CVEs (e.g. c-ares/libexpat flagged the daily scan in 2026-07).
ARG CACHEBUST=none
RUN echo "cachebust: ${CACHEBUST}" && apk upgrade --no-cache

COPY ciphra.conf       /etc/nginx/conf.d/default.conf
COPY proxy_params.conf /etc/nginx/proxy_params.conf

# Strip the stock welcome config that ships in the base image.
RUN rm -f /etc/nginx/conf.d/default.conf.template

EXPOSE 443
