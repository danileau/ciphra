{
  "name": "ciphra",
  "version": "1.5.3",
  "private": true,
  "description": "Zero-knowledge health notebook for chronic conditions — data is encrypted in the browser, the server only ever stores ciphertext.",
  "license": "AGPL-3.0-only",
  "homepage": "https://ciphra.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danileau/ciphra.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/danileau/ciphra/issues"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:visual": "playwright test e2e/visual-smoke.spec.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "argon2": "^0.45.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.32",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "dependencies": {
    "argon2-browser": "^1.18.0",
    "chart.js": "^4.6.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "marked": "^18.1.3"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "uuid": "^14.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
